{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "duvar-chi.vercel.app"
        }
      ],
      "destination": "https://duvar.site/:path*",
      "permanent": true
    },
    {
      "source": "/render",
      "destination": "/rehber/ekran-goruntusunden-render/",
      "permanent": false
    },
    {
      "source": "/juri",
      "destination": "/#araclar/juri",
      "permanent": false
    },
    {
      "source": "/palet",
      "destination": "/#araclar/palet",
      "permanent": false
    },
    {
      "source": "/olcek",
      "destination": "/#araclar/olcek",
      "permanent": false
    },
    {
      "source": "/sayac",
      "destination": "/#araclar/sayac",
      "permanent": false
    },
    {
      "source": "/araclar",
      "destination": "/#araclar",
      "permanent": false
    }
  ]
}
